{
  "name": "Call Recorder",
  "short_name": "CallRec",
  "description": "Record calls on speakerphone and keep them organised by contact name and date.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f766e",
  "theme_color": "#0f766e",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Call Recorder</title>
<meta name="theme-color" content="#0f766e">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<style>
:root{
  --bg:#f4f6f8;--card:#ffffff;--text:#0f172a;--muted:#64748b;--line:#e2e8f0;
  --head:#0f766e;--accent:#0f766e;--accent-text:#ffffff;--danger:#dc2626;--rec:#dc2626;--field:#f8fafc;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0b1220;--card:#131c2e;--text:#e5e7eb;--muted:#94a3b8;--line:#243047;
    --head:#115e59;--accent:#2dd4bf;--accent-text:#042f2e;--danger:#f87171;--rec:#ef4444;--field:#0f1829;
  }
}
:root[data-theme="dark"]{
  --bg:#0b1220;--card:#131c2e;--text:#e5e7eb;--muted:#94a3b8;--line:#243047;
  --head:#115e59;--accent:#2dd4bf;--accent-text:#042f2e;--danger:#f87171;--rec:#ef4444;--field:#0f1829;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0}
body{
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  background:var(--bg);color:var(--text);
  padding-bottom:env(safe-area-inset-bottom);
  -webkit-tap-highlight-color:transparent;
}
button,input,select{font:inherit;color:inherit}
.top{
  position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;
  padding:12px 16px;padding-top:calc(12px + env(safe-area-inset-top));
  background:var(--head);color:#fff;
}
.top h1{font-size:18px;margin:0;font-weight:650}
.top-actions{display:flex;gap:8px;align-items:center}
.icon-btn{background:transparent;border:1px solid rgba(255,255,255,.4);color:#fff;border-radius:10px;width:40px;height:40px;font-size:20px;cursor:pointer}
main{max-width:640px;margin:0 auto;padding:12px 16px 32px;display:grid;gap:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px}
h2{font-size:16px;margin:0}
h3{font-size:14px;margin:0 0 8px}
label{display:block;font-size:13px;color:var(--muted);margin:10px 0 4px}
input[type=text],input[type=search],input[type=number],input[type=password],input:not([type]),select{
  width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:10px;background:var(--field);font-size:16px;
}
.row{display:flex;gap:8px;align-items:center}
.row.end{justify-content:flex-end;margin-top:12px}
.row>input{flex:1;min-width:0}
.btn{
  border:1px solid var(--line);background:var(--card);border-radius:10px;padding:10px 14px;cursor:pointer;font-size:15px;white-space:nowrap;
}
.btn.small{padding:7px 10px;font-size:13px}
.btn.primary{background:var(--accent);color:var(--accent-text);border-color:var(--accent)}
.btn.danger{color:var(--danger);border-color:var(--danger)}
.btn:disabled{opacity:.45;cursor:default}
.top .btn{background:transparent;color:#fff;border-color:rgba(255,255,255,.45)}
details{background:var(--field);border:1px solid var(--line);border-radius:10px;padding:8px 12px}
summary{cursor:pointer;font-size:14px;font-weight:600}
details ol{margin:8px 0 2px;padding-left:20px;font-size:14px;line-height:1.5;color:var(--muted)}
.timer{font-size:44px;text-align:center;margin:14px 0 6px;font-variant-numeric:tabular-nums;letter-spacing:1px}
.meter{height:8px;background:var(--line);border-radius:4px;overflow:hidden;margin:0 8px 14px}
#meterBar{height:100%;width:0;background:var(--accent);transition:width .08s linear}
.controls{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:8px}
.controls button{padding:14px 8px;border-radius:12px;border:1px solid var(--line);background:var(--card);font-size:16px;cursor:pointer}
.controls .rec{background:var(--rec);border-color:var(--rec);color:#fff;font-weight:650}
.controls button:disabled{opacity:.4;cursor:default}
body.recording .timer{color:var(--rec)}
.status{min-height:20px;margin:10px 0 0;text-align:center;font-size:14px;color:var(--muted)}
.notice,.hint{font-size:12.5px;color:var(--muted);line-height:1.45;margin:10px 0 0}
.muted{color:var(--muted);font-size:14px}
.lib-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.chip{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:6px 12px;font-size:13px;cursor:pointer}
.chip.on{background:var(--accent);color:var(--accent-text);border-color:var(--accent)}
.list{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:8px}
.item{border:1px solid var(--line);border-radius:12px;background:var(--field);overflow:hidden}
.item-head{display:flex;align-items:center}
.star{background:transparent;border:0;font-size:22px;width:48px;height:56px;cursor:pointer;color:var(--muted)}
.star.on{color:#f59e0b}
.item-info{flex:1;min-width:0;text-align:left;background:transparent;border:0;padding:8px 12px 8px 0;cursor:pointer;display:flex;flex-direction:column;gap:2px}
.item-name{font-weight:600;font-size:16px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item-date{font-size:13px;color:var(--muted)}
.item-body{padding:4px 12px 12px;display:grid;gap:10px}
.item-body audio{width:100%}
.speeds,.actions{display:flex;gap:8px;flex-wrap:wrap}
.lock{position:fixed;inset:0;z-index:50;background:var(--bg);display:grid;place-items:center;padding:20px}
.lock-box{width:100%;max-width:320px;display:grid;gap:12px;text-align:center}
.lock-box input{text-align:center;letter-spacing:6px}
.err{color:var(--danger);min-height:18px;margin:0;font-size:14px}
dialog{
  border:1px solid var(--line);border-radius:14px;background:var(--card);color:var(--text);
  width:min(92vw,460px);padding:16px;max-height:85vh;overflow:auto;
}
dialog::backdrop{background:rgba(0,0,0,.5)}
.dlg-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
.sec{border-top:1px solid var(--line);padding:12px 0}
.sec:first-of-type{border-top:0}
.bar{height:8px;background:var(--line);border-radius:4px;overflow:hidden;margin-bottom:6px}
#storageBar{height:100%;width:0;background:var(--accent)}
#toast{
  position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translate(-50%,20px);
  background:#111827;color:#fff;padding:10px 16px;border-radius:10px;font-size:14px;max-width:90vw;
  opacity:0;pointer-events:none;transition:.2s;z-index:100;text-align:center;
}
#toast.show{opacity:1;transform:translate(-50%,0)}
</style>
</head>
<body>

<div id="lock" class="lock" hidden>
  <div class="lock-box">
    <h2>Enter PIN</h2>
    <input id="pinInput" type="password" inputmode="numeric" maxlength="8" autocomplete="off" placeholder="PIN">
    <button id="pinBtn" class="btn primary" type="button">Unlock</button>
    <p id="pinErr" class="err" role="alert"></p>
  </div>
</div>

<header class="top">
  <h1>Call Recorder</h1>
  <div class="top-actions">
    <button id="installBtn" class="btn small" type="button" hidden>Install</button>
    <button id="settingsBtn" class="icon-btn" type="button" aria-label="Settings">&#9881;</button>
  </div>
</header>

<main>
  <section class="card" id="recorder">
    <details id="guide" open>
      <summary>How to record a call</summary>
      <ol>
        <li>Pick the contact below (or type the name).</li>
        <li>Start or answer the call and turn on <b>speakerphone</b>.</li>
        <li>Tap <b>Record</b>. Keep this app open and the screen on.</li>
        <li>Tap <b>Stop</b> when the call ends. It is saved automatically.</li>
      </ol>
    </details>

    <label for="contactName">Contact</label>
    <div class="row">
      <input id="contactName" list="nameList" placeholder="Contact name" autocomplete="off" autocapitalize="words">
      <button id="pickBtn" class="btn" type="button">Contacts</button>
    </div>
    <datalist id="nameList"></datalist>

    <div class="timer" id="timer">00:00</div>
    <div class="meter"><div id="meterBar"></div></div>

    <div class="controls">
      <button id="recBtn" class="rec" type="button">Record</button>
      <button id="pauseBtn" type="button" disabled>Pause</button>
      <button id="stopBtn" type="button" disabled>Stop</button>
    </div>
    <p id="recStatus" class="status" role="status"></p>
    <p class="notice">Tell the other person that the call is being recorded.</p>
  </section>

  <section class="card">
    <div class="lib-head">
      <h2>Recordings <span id="count" class="muted"></span></h2>
      <button id="favFilter" class="chip" type="button">&#9733; Favourites</button>
    </div>
    <input id="search" type="search" placeholder="Search by name or date">
    <ul id="list" class="list"></ul>
    <p id="empty" class="muted">No recordings yet.</p>
  </section>
</main>

<dialog id="settings">
  <div class="dlg-head">
    <h2>Settings</h2>
    <button id="closeSettings" class="btn small" type="button">Close</button>
  </div>

  <div class="sec">
    <h3>Appearance</h3>
    <select id="themeSel">
      <option value="auto">Auto (follow phone)</option>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
    </select>
  </div>

  <div class="sec">
    <h3>Storage</h3>
    <div class="bar"><div id="storageBar"></div></div>
    <p id="storageText" class="muted"></p>
    <p id="recSize" class="muted"></p>
    <p id="fmtText" class="hint"></p>
    <div class="row" style="margin-top:10px">
      <input id="cleanDays" type="number" min="1" value="30" inputmode="numeric" aria-label="Days">
      <button id="cleanBtn" class="btn" type="button">Delete older than (days)</button>
    </div>
    <p class="hint">Favourites are never deleted this way.</p>
  </div>

  <div class="sec">
    <h3>Backup</h3>
    <p class="hint" style="margin-top:0">Recordings live only inside this browser. Clearing the site data deletes them, so export a backup now and then.</p>
    <div class="row" style="margin-top:10px">
      <button id="exportBtn" class="btn" type="button">Export backup</button>
      <button id="importBtn" class="btn" type="button">Import backup</button>
    </div>
    <input id="importFile" type="file" accept="application/json,.json" hidden>
  </div>

  <div class="sec">
    <h3>PIN lock</h3>
    <p id="pinState" class="muted" style="margin-top:0"></p>
    <div class="row">
      <input id="newPin" type="password" inputmode="numeric" maxlength="8" placeholder="4 to 8 digits" autocomplete="off">
      <button id="setPin" class="btn" type="button">Set PIN</button>
    </div>
    <button id="removePin" class="btn danger small" type="button" style="margin-top:8px" hidden>Remove PIN</button>
    <p class="hint">The PIN only keeps casual visitors out when the app opens. It does not encrypt the recordings. Do not forget it.</p>
  </div>
</dialog>

<dialog id="consent">
  <form method="dialog">
    <h2>Before you record</h2>
    <p class="muted">Many places require the other person's consent to record a call. Tell them the call is being recorded and follow your local law. You are responsible for how you use recordings.</p>
    <div class="row end">
      <button class="btn" value="cancel">Cancel</button>
      <button class="btn primary" value="ok">I understand</button>
    </div>
  </form>
</dialog>

<div id="toast" role="status"></div>

<script>
(() => {
'use strict';

/* ---------- helpers ---------- */
const $ = id => document.getElementById(id);
const el = (tag, cls) => { const e = document.createElement(tag); if (cls) e.className = cls; return e; };
const btn = (text, cls) => { const b = el('button', 'btn small' + (cls ? ' ' + cls : '')); b.type = 'button'; b.textContent = text; return b; };
const store = {
  get(k, d) { try { const v = localStorage.getItem(k); return v === null ? d : v; } catch { return d; } },
  set(k, v) { try { localStorage.setItem(k, v); } catch {} },
  del(k) { try { localStorage.removeItem(k); } catch {} }
};
const pad = n => String(n).padStart(2, '0');
const dtf = new Intl.DateTimeFormat(undefined, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' });
const fmtDate = ts => dtf.format(new Date(ts));
const stamp = ts => { const d = new Date(ts); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}_${pad(d.getHours())}-${pad(d.getMinutes())}`; };
const fmtTime = s => { s = Math.floor(s); const h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), x = s % 60; return h ? `${h}:${pad(m)}:${pad(x)}` : `${pad(m)}:${pad(x)}`; };
const mb = b => b >= 1073741824 ? (b / 1073741824).toFixed(1) + ' GB' : (b / 1048576).toFixed(1) + ' MB';
const extFor = m => /mp4|aac/.test(m) ? 'm4a' : /ogg/.test(m) ? 'ogg' : 'webm';
const safe = s => (s.replace(/[\\/:*?"<>|\u0000-\u001f]+/g, '_').trim()) || 'recording';

let toastTimer = 0;
function toast(msg) {
  const t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove('show'), 3400);
}
function downloadBlob(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 10000);
}

/* ---------- IndexedDB ---------- */
const DB_NAME = 'callrec', STORE = 'recordings';
let dbPromise = null;
function openDB() {
  return new Promise((res, rej) => {
    const r = indexedDB.open(DB_NAME, 1);
    r.onupgradeneeded = () => {
      const s = r.result.createObjectStore(STORE, { keyPath: 'id', autoIncrement: true });
      s.createIndex('createdAt', 'createdAt');
    };
    r.onsuccess = () => res(r.result);
    r.onerror = () => rej(r.error);
  });
}
const getDB = () => dbPromise || (dbPromise = openDB());
async function tx(mode, fn) {
  const d = await getDB();
  return new Promise((res, rej) => {
    const t = d.transaction(STORE, mode);
    let out;
    const req = fn(t.objectStore(STORE));
    if (req) req.onsuccess = () => { out = req.result; };
    t.oncomplete = () => res(out);
    t.onerror = () => rej(t.error);
    t.onabort = () => rej(t.error);
  });
}
const dbAll = () => tx('readonly', s => s.getAll());
const dbAdd = rec => tx('readwrite', s => s.add(rec));
const dbPut = rec => tx('readwrite', s => s.put(rec));
const dbDel = id => tx('readwrite', s => s.delete(id));

/* ---------- recorder ---------- */
const contact = $('contactName');
const supportsPicker = 'contacts' in navigator && 'ContactsManager' in window;
let state = 'idle';            // idle | rec | paused
let stream = null, recorder = null, chunks = [];
let recName = '', recMime = '', recStartedAt = 0;
let elapsed = 0, segStart = 0, timerId = 0;
let actx = null, rafId = 0, wake = null;

function pickMime() {
  if (!window.MediaRecorder) return '';
  const list = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4', 'audio/ogg;codecs=opus'];
  return list.find(t => MediaRecorder.isTypeSupported(t)) || '';
}

function ensureConsent() {
  if (store.get('consent') === '1') return Promise.resolve(true);
  const d = $('consent');
  return new Promise(res => {
    d.returnValue = '';
    const done = () => {
      d.removeEventListener('close', done);
      if (d.returnValue === 'ok') { store.set('consent', '1'); res(true); } else res(false);
    };
    d.addEventListener('close', done);
    d.showModal();
  });
}

async function keepAwake() {
  try {
    if ('wakeLock' in navigator && !wake) {
      wake = await navigator.wakeLock.request('screen');
      wake.addEventListener('release', () => { wake = null; });
    }
  } catch {}
}
function releaseAwake() { try { if (wake) wake.release(); } catch {} wake = null; }

function setupMeter() {
  try {
    const AC = window.AudioContext || window.webkitAudioContext;
    actx = new AC();
    const src = actx.createMediaStreamSource(stream);
    const analyser = actx.createAnalyser();
    analyser.fftSize = 512;
    src.connect(analyser);
    const buf = new Uint8Array(analyser.fftSize);
    const loop = () => {
      analyser.getByteTimeDomainData(buf);
      let sum = 0;
      for (let i = 0; i < buf.length; i++) { const v = (buf[i] - 128) / 128; sum += v * v; }
      $('meterBar').style.width = Math.min(100, Math.round(Math.sqrt(sum / buf.length) * 400)) + '%';
      rafId = requestAnimationFrame(loop);
    };
    loop();
  } catch {}
}

function teardown() {
  clearInterval(timerId); timerId = 0;
  cancelAnimationFrame(rafId); rafId = 0;
  $('meterBar').style.width = '0';
  if (actx) { try { actx.close(); } catch {} actx = null; }
  if (stream) { stream.getTracks().forEach(t => { t.onended = null; t.stop(); }); stream = null; }
  releaseAwake();
}

function currentSeconds() {
  return elapsed + (state === 'rec' ? (performance.now() - segStart) / 1000 : 0);
}

function ui() {
  const idle = state === 'idle';
  $('recBtn').disabled = !idle;
  $('pauseBtn').disabled = idle;
  $('stopBtn').disabled = idle;
  $('pauseBtn').textContent = state === 'paused' ? 'Resume' : 'Pause';
  contact.disabled = !idle;
  $('pickBtn').disabled = !idle;
  $('recStatus').textContent = state === 'rec' ? `Recording ${recName}…` : state === 'paused' ? 'Paused' : '';
  document.body.classList.toggle('recording', state === 'rec');
  if (idle) $('timer').textContent = '00:00';
}

async function startRec() {
  if (state !== 'idle') return;
  if (!window.MediaRecorder || !navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    toast('Recording is not supported here. Open the app over HTTPS in a recent browser.');
    return;
  }
  if (!(await ensureConsent())) return;
  try {
    // Echo cancellation and noise suppression are OFF on purpose, otherwise the
    // other person's voice coming from the speaker is treated as echo and removed.
    stream = await navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: true, channelCount: 1 }
    });
  } catch {
    toast('Microphone permission was denied.');
    return;
  }
  recName = contact.value.trim() || 'Unknown';
  recMime = pickMime();
  try {
    recorder = new MediaRecorder(stream, recMime ? { mimeType: recMime } : undefined);
  } catch {
    toast('Could not start the recorder.');
    teardown();
    return;
  }
  chunks = []; elapsed = 0; recStartedAt = Date.now();
  recorder.ondataavailable = e => { if (e.data && e.data.size) chunks.push(e.data); };
  recorder.onstop = onRecorderStop;
  recorder.onerror = () => toast('Recording error.');
  const track = stream.getAudioTracks()[0];
  if (track) track.onended = () => { if (state !== 'idle') { toast('Microphone stopped. Saving what was recorded.'); stopRec(); } };
  recorder.start(1000);
  segStart = performance.now();
  state = 'rec';
  setupMeter();
  keepAwake();
  timerId = setInterval(() => { $('timer').textContent = fmtTime(currentSeconds()); }, 250);
  ui();
}

function togglePause() {
  if (!recorder) return;
  if (state === 'rec') {
    recorder.pause();
    elapsed += (performance.now() - segStart) / 1000;
    state = 'paused';
  } else if (state === 'paused') {
    recorder.resume();
    segStart = performance.now();
    state = 'rec';
  }
  ui();
}

function stopRec() {
  if (state === 'idle' || !recorder) return;
  if (recorder.state !== 'inactive') { try { recorder.stop(); } catch {} }
}

async function onRecorderStop() {
  if (state === 'idle') return;
  const duration = currentSeconds();
  const name = recName;
  const type = (recorder && recorder.mimeType) || recMime || 'audio/webm';
  const blob = new Blob(chunks, { type });
  const createdAt = recStartedAt;
  chunks = []; recorder = null; state = 'idle';
  teardown();
  ui();
  if (!blob.size) { toast('Nothing was recorded.'); return; }
  try {
    await dbAdd({ name, createdAt, mime: type, duration, fav: false, blob });
    toast('Saved: ' + name);
    await refresh();
  } catch {
    toast('Could not save in the app. Downloading the file instead.');
    downloadBlob(blob, `${safe(name)}_${stamp(createdAt)}.${extFor(type)}`);
  }
}

/* ---------- library ---------- */
let items = [];
let favOnly = false;
let cleanups = [];
const list = $('list');

async function refresh() {
  items = (await dbAll()).sort((a, b) => b.createdAt - a.createdAt);
  renderList();
  updateNames();
}

function updateNames() {
  const dl = $('nameList'); dl.replaceChildren();
  const seen = new Set();
  for (const it of items) {
    if (seen.has(it.name)) continue;
    seen.add(it.name);
    const o = document.createElement('option'); o.value = it.name; dl.append(o);
    if (seen.size >= 50) break;
  }
}

function afterListChange() {
  $('count').textContent = items.length ? `(${items.length})` : '';
  const visible = list.children.length;
  $('empty').hidden = visible > 0;
  $('empty').textContent = items.length ? 'No matches.' : 'No recordings yet.';
}

function setStar(b, on) { b.textContent = on ? '★' : '☆'; b.classList.toggle('on', on); b.setAttribute('aria-label', on ? 'Remove favourite' : 'Add favourite'); }

// Chrome's MediaRecorder files often report an infinite duration; this nudge fixes seeking.
function fixDuration(audio) {
  audio.addEventListener('loadedmetadata', () => {
    if (audio.duration === Infinity) {
      audio.currentTime = 1e101;
      audio.addEventListener('timeupdate', function h() { audio.removeEventListener('timeupdate', h); audio.currentTime = 0; });
    }
  });
}

function buildItem(it) {
  const li = el('li', 'item'); li.dataset.id = it.id;
  const head = el('div', 'item-head');
  const star = el('button', 'star'); star.type = 'button'; setStar(star, !!it.fav);
  const info = el('button', 'item-info'); info.type = 'button';
  const nm = el('span', 'item-name'); nm.textContent = it.name;
  const dt = el('span', 'item-date'); dt.textContent = fmtDate(it.createdAt);
  info.append(nm, dt); head.append(star, info);

  const body = el('div', 'item-body'); body.hidden = true;
  const holder = el('div', 'audio-holder');
  const speeds = el('div', 'speeds');
  const actions = el('div', 'actions');
  const bRename = btn('Rename'), bDl = btn('Download'), bDel = btn('Delete', 'danger');
  actions.append(bRename, bDl, bDel);

  let audio = null, url = null, speed = 1;
  [0.75, 1, 1.5, 2].forEach(sp => {
    const b = el('button', 'chip' + (sp === 1 ? ' on' : '')); b.type = 'button'; b.textContent = sp + 'x';
    b.onclick = () => {
      speed = sp;
      if (audio) audio.playbackRate = sp;
      speeds.querySelectorAll('.chip').forEach(x => x.classList.toggle('on', x === b));
    };
    speeds.append(b);
  });
  body.append(holder, speeds, actions);

  const open = () => {
    body.hidden = false;
    if (!audio) {
      url = URL.createObjectURL(it.blob);
      audio = document.createElement('audio');
      audio.controls = true; audio.preload = 'metadata'; audio.src = url;
      audio.playbackRate = speed;
      fixDuration(audio);
      holder.append(audio);
    }
  };
  const close = () => {
    body.hidden = true;
    if (audio) { audio.pause(); audio.remove(); audio = null; }
    if (url) { URL.revokeObjectURL(url); url = null; }
  };
  cleanups.push(close);

  info.onclick = () => { body.hidden ? open() : close(); };
  star.onclick = async () => {
    it.fav = !it.fav; setStar(star, it.fav);
    await dbPut(it);
    if (favOnly && !it.fav) renderList();
  };
  bRename.onclick = async () => {
    const n = prompt('Rename recording', it.name);
    if (n === null) return;
    const v = n.trim(); if (!v) return;
    it.name = v; nm.textContent = v;
    await dbPut(it); updateNames();
  };
  bDl.onclick = () => downloadBlob(it.blob, `${safe(it.name)}_${stamp(it.createdAt)}.${extFor(it.mime)}`);
  bDel.onclick = async () => {
    if (!confirm(`Delete the recording of ${it.name}?`)) return;
    close();
    await dbDel(it.id);
    items = items.filter(x => x.id !== it.id);
    li.remove(); afterListChange(); updateNames();
  };

  li.append(head, body);
  return li;
}

function renderList() {
  cleanups.forEach(f => f()); cleanups = [];
  const q = $('search').value.trim().toLowerCase();
  const shown = items.filter(it =>
    (!favOnly || it.fav) &&
    (!q || it.name.toLowerCase().includes(q) || fmtDate(it.createdAt).toLowerCase().includes(q))
  );
  list.replaceChildren(...shown.map(buildItem));
  afterListChange();
}

/* ---------- settings: theme, storage, cleanup ---------- */
function applyTheme(t) {
  const r = document.documentElement;
  if (t === 'light' || t === 'dark') r.dataset.theme = t; else delete r.dataset.theme;
  $('themeSel').value = t;
  const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
  document.querySelector('meta[name=theme-color]').content = dark ? '#115e59' : '#0f766e';
}

async function showStorage() {
  const total = items.reduce((s, i) => s + (i.blob ? i.blob.size : 0), 0);
  $('recSize').textContent = `Recordings: ${items.length} (${mb(total)})`;
  const f = pickMime();
  $('fmtText').textContent = f ? `Recording format: ${f.split(';')[0]}` : 'Recording format: not supported in this browser';
  try {
    if (navigator.storage && navigator.storage.estimate) {
      const { usage = 0, quota = 0 } = await navigator.storage.estimate();
      $('storageText').textContent = `Browser storage used: ${mb(usage)} of ${mb(quota)}`;
      $('storageBar').style.width = quota ? Math.min(100, usage / quota * 100) + '%' : '0%';
    } else { $('storageText').textContent = 'Storage info is not available.'; }
  } catch { $('storageText').textContent = 'Storage info is not available.'; }
}

async function deleteOld() {
  const days = parseInt($('cleanDays').value, 10);
  if (!(days >= 1)) { toast('Enter the number of days.'); return; }
  const cutoff = Date.now() - days * 86400000;
  const victims = items.filter(i => i.createdAt < cutoff && !i.fav);
  if (!victims.length) { toast('Nothing to delete.'); return; }
  if (!confirm(`Delete ${victims.length} recording(s) older than ${days} days? Favourites are kept.`)) return;
  for (const v of victims) await dbDel(v.id);
  await refresh(); showStorage();
  toast(`Deleted ${victims.length} recording(s).`);
}

/* ---------- backup / restore ---------- */
function blobToDataURL(b) {
  return new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res(r.result); r.onerror = () => rej(r.error); r.readAsDataURL(b); });
}
async function exportAll() {
  if (!items.length) { toast('No recordings to export.'); return; }
  toast('Preparing backup…');
  try {
    const parts = ['{"app":"callrec","version":1,"items":['];
    for (let i = 0; i < items.length; i++) {
      const it = items[i];
      const data = await blobToDataURL(it.blob);
      parts.push((i ? ',' : '') + JSON.stringify({ name: it.name, createdAt: it.createdAt, mime: it.mime, duration: it.duration, fav: !!it.fav, data }));
    }
    parts.push(']}');
    downloadBlob(new Blob(parts, { type: 'application/json' }), `call-recorder-backup-${stamp(Date.now())}.json`);
  } catch { toast('Backup failed. Try fewer recordings or free some memory.'); }
}
async function importFile(file) {
  let data;
  try { data = JSON.parse(await file.text()); } catch { toast('That file is not a valid backup.'); return; }
  if (!data || data.app !== 'callrec' || !Array.isArray(data.items)) { toast('That is not a Call Recorder backup.'); return; }
  const have = new Set(items.map(i => i.createdAt + '|' + i.name));
  let added = 0;
  for (const it of data.items) {
    if (!it || !it.data || !it.name) continue;
    const key = it.createdAt + '|' + it.name;
    if (have.has(key)) continue;
    const blob = await (await fetch(it.data)).blob();
    await dbAdd({ name: String(it.name), createdAt: Number(it.createdAt) || Date.now(), mime: it.mime || blob.type, duration: Number(it.duration) || 0, fav: !!it.fav, blob });
    have.add(key); added++;
  }
  await refresh(); showStorage();
  toast(`Imported ${added} recording(s).`);
}

/* ---------- PIN lock ---------- */
const canHash = !!(window.crypto && crypto.subtle);
async function hashPin(pin, salt) {
  const h = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(salt + ':' + pin));
  return Array.from(new Uint8Array(h)).map(b => b.toString(16).padStart(2, '0')).join('');
}
function pinUi() {
  const on = !!store.get('pinHash');
  $('pinState').textContent = on ? 'PIN lock is on.' : 'PIN lock is off.';
  $('removePin').hidden = !on;
  $('setPin').textContent = on ? 'Change PIN' : 'Set PIN';
}
async function setPin() {
  const v = $('newPin').value.trim();
  if (!canHash) { toast('PIN needs the app to be opened over HTTPS.'); return; }
  if (!/^\d{4,8}$/.test(v)) { toast('PIN must be 4 to 8 digits.'); return; }
  const salt = Array.from(crypto.getRandomValues(new Uint32Array(2))).join('-');
  store.set('pinSalt', salt);
  store.set('pinHash', await hashPin(v, salt));
  $('newPin').value = '';
  pinUi(); toast('PIN saved.');
}
function removePin() { store.del('pinHash'); store.del('pinSalt'); pinUi(); toast('PIN removed.'); }
function lockApp() {
  if (!store.get('pinHash') || !canHash) return;
  $('lock').hidden = false;
  $('pinInput').value = ''; $('pinErr').textContent = '';
  setTimeout(() => $('pinInput').focus(), 50);
}
async function tryUnlock() {
  const v = $('pinInput').value.trim();
  const h = await hashPin(v, store.get('pinSalt', ''));
  if (h === store.get('pinHash')) { $('lock').hidden = true; }
  else { $('pinErr').textContent = 'Wrong PIN'; $('pinInput').value = ''; }
}

/* ---------- wiring ---------- */
$('recBtn').onclick = startRec;
$('pauseBtn').onclick = togglePause;
$('stopBtn').onclick = stopRec;

$('pickBtn').onclick = async () => {
  try {
    const r = await navigator.contacts.select(['name'], { multiple: false });
    const n = r && r[0] && r[0].name && r[0].name[0];
    if (n) contact.value = n;
  } catch {}
};
if (!supportsPicker) $('pickBtn').hidden = true;

$('search').addEventListener('input', renderList);
$('favFilter').onclick = () => { favOnly = !favOnly; $('favFilter').classList.toggle('on', favOnly); renderList(); };

$('settingsBtn').onclick = () => { showStorage(); pinUi(); $('settings').showModal(); };
$('closeSettings').onclick = () => $('settings').close();
$('themeSel').onchange = e => { store.set('theme', e.target.value); applyTheme(e.target.value); };
$('cleanBtn').onclick = deleteOld;
$('exportBtn').onclick = exportAll;
$('importBtn').onclick = () => $('importFile').click();
$('importFile').onchange = async e => { const f = e.target.files[0]; e.target.value = ''; if (f) await importFile(f); };
$('setPin').onclick = setPin;
$('removePin').onclick = removePin;
$('pinBtn').onclick = tryUnlock;
$('pinInput').addEventListener('keydown', e => { if (e.key === 'Enter') tryUnlock(); });

let hiddenAt = 0;
document.addEventListener('visibilitychange', () => {
  if (document.hidden) { hiddenAt = Date.now(); return; }
  if (state !== 'idle') keepAwake();
  if (hiddenAt && Date.now() - hiddenAt > 60000 && state === 'idle') lockApp();
  hiddenAt = 0;
});
window.addEventListener('beforeunload', e => { if (state !== 'idle') { e.preventDefault(); e.returnValue = ''; } });

let installEvt = null;
window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); installEvt = e; $('installBtn').hidden = false; });
$('installBtn').onclick = async () => {
  if (!installEvt) return;
  installEvt.prompt();
  try { await installEvt.userChoice; } catch {}
  installEvt = null; $('installBtn').hidden = true;
};
window.addEventListener('appinstalled', () => { $('installBtn').hidden = true; });

if ('serviceWorker' in navigator && location.protocol !== 'file:') {
  navigator.serviceWorker.register('sw.js').catch(() => {});
}

/* ---------- start ---------- */
(async function init() {
  applyTheme(store.get('theme', 'auto'));
  pinUi();
  lockApp();
  try { await refresh(); } catch { toast('Storage is not available in this browser mode.'); }
  if (navigator.storage && navigator.storage.persist) navigator.storage.persist().catch(() => {});
  ui();
})();
})();
</script>
